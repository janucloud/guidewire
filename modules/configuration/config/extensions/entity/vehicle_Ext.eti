<?xml version="1.0"?>
<entity
  xmlns="http://guidewire.com/datamodel"
  entity="vehicle_Ext"
  desc="Parent:base entity"
  table="vehicle_ext"
  type="retireable"
  final="false">
  <column
    name="Manufacturer"
    nullok="true"
    type="varchar">
    <columnParam
      name="size"
      value="30"/>
  </column>
  <column
    name="Year"
    nullok="false"
    type="integer"></column>
  <column
    name="ModelName"
    nullok="false"
    type="varchar">
    <columnParam
      name="size"
      value="30"/>
  </column>
</entity>