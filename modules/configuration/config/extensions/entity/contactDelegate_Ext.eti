<?xml version="1.0"?>
<delegate
  xmlns="http://guidewire.com/datamodel"
  name="contactDelegate_Ext">
  <column
    name="PrimaryContactName"
    nullok="true"
    type="varchar">
    <columnParam
      name="size"
      value="30"/>
  </column>
  <column
    name="PrimaryContactphone"
    nullok="true"
    type="integer"/>
  <column
    name="PrimaryContactEmail"
    nullok="true"
    type="varchar">
    <columnParam
      name="size"
      value="30"/>
  </column>
</delegate>