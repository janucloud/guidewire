<?xml version="1.0"?>
<entity
  xmlns="http://guidewire.com/datamodel"
  entity="studentData_Ext"
  desc="for pcf demo purpose"
  table="studentdata_ext"
  type="retireable"
  final="false">
  <column
    name="FisrtName"
    nullok="true"
    type="shorttext"></column>
  <column
    name="LastName"
    nullok="true"
    type="shorttext"></column>
  <column
    name="DOB"
    nullok="true"
    type="varchar">
    <columnParam
      name="size"
      value="10"/>
  </column>
  <typekey
    name="Country"
    nullok="true"
    typelist="Country_Ext"/>
  <typekey
    name="Statelist"
    nullok="true"
    typelist="State_Ext">
    <keyfilters>
      <keyfilter
        name="Country"/>
    </keyfilters>
  </typekey>
  <array
    arrayentity="subject_Ext"
    desc="choices of subject"
    name="Subject"/>
  <column
    name="AadharNumber"
    nullok="true"
    type="integer"/>
  <column
    name="PanNumber"
    nullok="true"
    type="shorttext"/>
  <column
    desc="(Social Security Number)"
    name="SSN"
    nullok="true"
    type="integer"/>
  <column
    name="ResidentIdentityNumber"
    nullok="true"
    type="integer"></column>
  <column
    name="ContactNumber"
    nullok="true"
    type="integer"/>
  <column
    name="Email_ID"
    nullok="true"
    type="shorttext"/>
  <column
    name="Age"
    nullok="true"
    type="integer"></column>
  <column
    name="Address"
    nullok="true"
    type="varchar">
    <columnParam
      name="size"
      value="65"/>
  </column>
</entity>